---
import '@fontsource/oswald'
import '@fontsource/open-sans'
import '../style.css'
import openSansWoff2 from '@fontsource/open-sans/files/open-sans-latin-400-normal.woff2'
import oswaldWoff2 from '@fontsource/oswald/files/oswald-latin-400-normal.woff2'
import Header from '../components/header.astro'
import FacebookIcon from './facebook-icon.astro'
import InstagramIcon from './instagram-icon.astro'
import floradayAssociationLogo from '../images/website/helston-floraday-association.jpg'
import { Image } from 'astro:assets'

const { title: pageTitle } = Astro.props

const title = pageTitle
  ? pageTitle + ' | Helston Flora Day'
  : 'Helston Flora Day | The Official Site'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={oswaldWoff2}
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={openSansWoff2}
      crossorigin="anonymous"
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <script
      defer
      src="https://celadon-seriema.pikapod.net/script.js"
      data-website-id="605cf37f-33df-42a8-9fd9-351295db051b"
      data-domains="helstonfloraday.org.uk"></script>
  </head>
  <body class="bg-primary text-lg font-medium text-neutral-700">
    <Header />
    <main class="bg-white bg-[url('/bg.png')]">
      <slot name="title">
        <h1
          class="bg-primary font-display text-secondary border-b border-neutral-800 py-14 text-center text-6xl"
        >
          {pageTitle}
        </h1>
      </slot>

      <div class="container py-12">
        <slot />
      </div>
    </main>

    <footer class="bg-primary border-t border-neutral-800 py-12">
      <div class="container text-center font-bold text-white">
        <div class="flex justify-center gap-16">
          <a
            class="hover:text-secondary flex flex-col items-center gap-2"
            target="_blank"
            href="https://www.facebook.com/Helstonfloradayassociation/"
          >
            <span class="block size-12"><FacebookIcon /></span>
            <span>Facebook</span>
          </a>
          <a
            class="hover:text-secondary flex flex-col items-center gap-2"
            target="_blank"
            href="https://www.instagram.com/HELSTONFLORADAY/"
          >
            <span class="block size-12"><InstagramIcon /></span>
            <span>Instagram</span>
          </a>
        </div>
        <div class="text-secondary mt-8">
          Copyright Helston Flora Day Association
        </div>
        <div class="mt-8 flex justify-center">
          <Image
            src={floradayAssociationLogo}
            alt=""
            class="max-w-60 rounded-3xl shadow-xl"
          />
        </div>
      </div>
    </footer>
  </body>
</html>
